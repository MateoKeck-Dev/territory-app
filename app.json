{
  "expo": {
    "name": "territory-app",
    "slug": "territory-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "territoryapp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mateokeck.territoryapp"
    },
    "android": {
      "package": "com.mateokeck.territoryapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@rnmapbox/maps",
      "expo-sqlite",
      "expo-task-manager",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Territory needs your location, even in the background, to track your walk and claim ground for your dog.",
          "locationWhenInUsePermission": "Territory needs your location to track your walk and claim ground for your dog.",
          "locationAlwaysPermission": "Territory needs your location, even in the background, to track your walk and claim ground for your dog.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ]
  }
}
